# Android Recovery File System Table (fstab) for Lenovo Tab M11 (TB311FU / poplar / tb8786p1_64_k66)
# <src>                                      <mnt_point>     <type>  <mnt_flags and options>                             <fs_mgr_flags>

# Logical Dynamic Partitions in Super (EROFS with EXT4 fallback)
system                                       /system         erofs   ro                                                  wait,slotselect,logical,first_stage_mount
system                                       /system         ext4    ro                                                  wait,slotselect,logical,first_stage_mount
vendor                                       /vendor         erofs   ro                                                  wait,slotselect,logical,first_stage_mount
vendor                                       /vendor         ext4    ro                                                  wait,slotselect,logical,first_stage_mount
product                                      /product        erofs   ro                                                  wait,slotselect,logical,first_stage_mount
product                                      /product        ext4    ro                                                  wait,slotselect,logical,first_stage_mount
system_ext                                   /system_ext     erofs   ro                                                  wait,slotselect,logical,first_stage_mount
system_ext                                   /system_ext     ext4    ro                                                  wait,slotselect,logical,first_stage_mount
odm_dlkm                                     /odm_dlkm       erofs   ro                                                  wait,slotselect,logical,first_stage_mount
odm_dlkm                                     /odm_dlkm       ext4    ro                                                  wait,slotselect,logical,first_stage_mount
vendor_dlkm                                  /vendor_dlkm    erofs   ro                                                  wait,slotselect,logical,first_stage_mount
vendor_dlkm                                  /vendor_dlkm    ext4    ro                                                  wait,slotselect,logical,first_stage_mount
system_dlkm                                  /system_dlkm    erofs   ro                                                  wait,slotselect,logical,first_stage_mount
system_dlkm                                  /system_dlkm    ext4    ro                                                  wait,slotselect,logical,first_stage_mount

# Dynamic Super Block Device
/dev/block/by-name/super                     /super          emmc    defaults                                            defaults

# Metadata Partition (FBE v2 Intermediate Key Storage on MediaTek md_udc)
/dev/block/by-name/md_udc                    /metadata       ext4    noatime,nosuid,nodev,discard                        wait,check,formattable,first_stage_mount

# User Data Partition (F2FS with FBE v2)
/dev/block/by-name/userdata                  /data           f2fs    noatime,nosuid,nodev,discard,reserve_root=134217,resgid=1065,inlinecrypt wait,check,formattable,quota,latemount,fileencryption=aes-256-xts:aes-256-cts:v2,keydirectory=/metadata/vold/metadata_encryption

# Core Direct Physical Boot & Firmware Partitions (Slot-specific A/B)
/dev/block/by-name/boot                      /boot           emmc    defaults                                            wait,slotselect
/dev/block/by-name/init_boot                 /init_boot      emmc    defaults                                            wait,slotselect
/dev/block/by-name/vendor_boot               /vendor_boot    emmc    defaults                                            wait,slotselect
/dev/block/by-name/dtbo                      /dtbo           emmc    defaults                                            wait,slotselect
/dev/block/by-name/vbmeta                    /vbmeta         emmc    defaults                                            wait,slotselect
/dev/block/by-name/vbmeta_system             /vbmeta_system  emmc    defaults                                            wait,slotselect
/dev/block/by-name/vbmeta_vendor             /vbmeta_vendor  emmc    defaults                                            wait,slotselect

# Critical Calibration, Radio & Persistent Storage Partitions
/dev/block/by-name/nvram                     /nvram          emmc    defaults                                            defaults
/dev/block/by-name/nvdata                    /mnt/vendor/nvdata ext4 defaults                                            defaults
/dev/block/by-name/nvcfg                     /mnt/vendor/nvcfg  ext4 defaults                                            defaults
/dev/block/by-name/protect1                  /mnt/vendor/protect_f ext4 defaults                                         defaults
/dev/block/by-name/protect2                  /mnt/vendor/protect_s ext4 defaults                                         defaults
/dev/block/by-name/persist                   /mnt/vendor/persist   ext4 defaults                                         defaults
/dev/block/by-name/proinfo                   /proinfo        emmc    defaults                                            defaults
/dev/block/by-name/misc                      /misc           emmc    defaults                                            defaults
/dev/block/by-name/para                      /para           emmc    defaults                                            defaults
/dev/block/by-name/lenovocust                /lenovocust     ext4    defaults                                            defaults
/dev/block/by-name/lenovoraw                 /lenovoraw      emmc    defaults                                            defaults
/dev/block/by-name/seccfg                    /seccfg         emmc    defaults                                            defaults
/dev/block/by-name/frp                       /persistent     emmc    defaults                                            defaults

# Bootloader & TrustZone Security Partitions (A/B Slot-Specific on MT8786)
/dev/block/by-name/lk                        /bootloader     emmc    defaults                                            wait,slotselect
/dev/block/by-name/tee                       /tee            emmc    defaults                                            wait,slotselect
/dev/block/by-name/scp                       /scp            emmc    defaults                                            wait,slotselect
/dev/block/by-name/sspm                      /sspm           emmc    defaults                                            wait,slotselect
/dev/block/by-name/gz                        /gz             emmc    defaults                                            wait,slotselect
/dev/block/by-name/spmfw                     /spmfw          emmc    defaults                                            wait,slotselect
/dev/block/by-name/md1img                    /md1img         emmc    defaults                                            wait,slotselect

# Non-Slotted Firmware Partitions
/dev/block/by-name/logo                      /logo           emmc    defaults                                            defaults
/dev/block/by-name/expdb                     /expdb          emmc    defaults                                            defaults
/dev/block/by-name/boot_para                 /boot_para      emmc    defaults                                            defaults
/dev/block/by-name/otp                       /otp            emmc    defaults                                            defaults
