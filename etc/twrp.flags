# TWRP / OrangeFox Mount Flags for Lenovo Tab with Clear Case (TB311FU / poplar)
# Platform: MediaTek MT8786 / MT6768 (tb8786p1_64_k66)

# Dynamic Logical Partitions (in super)
/system                   erofs     system                               flags=display="System";logical;slotselect;backup=1;flashimg=1
/system                   ext4      system                               flags=display="System (EXT4)";logical;slotselect;backup=1;flashimg=1
/system_ext               erofs     system_ext                           flags=display="System_EXT";logical;slotselect;backup=1;flashimg=1
/system_ext               ext4      system_ext                           flags=display="System_EXT (EXT4)";logical;slotselect;backup=1;flashimg=1
/vendor                   erofs     vendor                               flags=display="Vendor";logical;slotselect;backup=1;flashimg=1
/vendor                   ext4      vendor                               flags=display="Vendor (EXT4)";logical;slotselect;backup=1;flashimg=1
/product                  erofs     product                              flags=display="Product";logical;slotselect;backup=1;flashimg=1
/product                  ext4      product                              flags=display="Product (EXT4)";logical;slotselect;backup=1;flashimg=1
/vendor_dlkm              erofs     vendor_dlkm                          flags=display="Vendor_DLKM";logical;slotselect;backup=1;flashimg=1
/vendor_dlkm              ext4      vendor_dlkm                          flags=display="Vendor_DLKM (EXT4)";logical;slotselect;backup=1;flashimg=1
/odm_dlkm                 erofs     odm_dlkm                             flags=display="ODM_DLKM";logical;slotselect;backup=1;flashimg=1
/odm_dlkm                 ext4      odm_dlkm                             flags=display="ODM_DLKM (EXT4)";logical;slotselect;backup=1;flashimg=1
/system_dlkm              erofs     system_dlkm                          flags=display="System_DLKM";logical;slotselect;backup=1;flashimg=1
/system_dlkm              ext4      system_dlkm                          flags=display="System_DLKM (EXT4)";logical;slotselect;backup=1;flashimg=1

# Core Physical Partitions & Data (F2FS + FBE)
/metadata                 ext4      /dev/block/by-name/md_udc            flags=display="Metadata";backup=1;flashimg=1
/data                     f2fs      /dev/block/by-name/userdata          flags=display="Data";backup=1;wipeingui

# Boot, Kernel & AVB Chained Partitions
/boot                     emmc      /dev/block/by-name/boot              flags=display="Boot";slotselect;backup=1;flashimg=1
/vendor_boot              emmc      /dev/block/by-name/vendor_boot       flags=display="Vendor Boot";slotselect;backup=1;flashimg=1
/init_boot                emmc      /dev/block/by-name/init_boot         flags=display="Init Boot";slotselect;backup=1;flashimg=1
/dtbo                     emmc      /dev/block/by-name/dtbo              flags=display="DTBO";backup=1;flashimg=1
/vbmeta                   emmc      /dev/block/by-name/vbmeta            flags=display="VBMeta";backup=1;flashimg=1
/vbmeta_system            emmc      /dev/block/by-name/vbmeta_system     flags=display="VBMeta System";slotselect;backup=1;flashimg=1
/vbmeta_vendor            emmc      /dev/block/by-name/vbmeta_vendor     flags=display="VBMeta Vendor";slotselect;backup=1;flashimg=1

# MediaTek NVRAM, Radio & Lenovo Custom Partitions
/mnt/vendor/protect_f     ext4      /dev/block/by-name/protect1          flags=display="Protect F";backup=1;flashimg=1
/mnt/vendor/protect_s     ext4      /dev/block/by-name/protect2          flags=display="Protect S";backup=1;flashimg=1
/mnt/vendor/nvdata        ext4      /dev/block/by-name/nvdata            flags=display="NVData";backup=1;flashimg=1
/mnt/vendor/nvcfg         ext4      /dev/block/by-name/nvcfg             flags=display="NVCfg";backup=1;flashimg=1
/lenovocust               ext4      /dev/block/by-name/lenovocust        flags=display="Lenovo Cust";backup=1;flashimg=1
/mnt/vendor/persist       ext4      /dev/block/by-name/persist           flags=display="Persist";backup=1;flashimg=1
/persistent               emmc      /dev/block/by-name/frp               flags=display="Persistent (FRP)";backup=1;flashimg=1
/nvram                    emmc      /dev/block/by-name/nvram             flags=display="NVRAM";backup=1;flashimg=1
/proinfo                  emmc      /dev/block/by-name/proinfo           flags=display="ProInfo";backup=1;flashimg=1
/lenovoraw                emmc      /dev/block/by-name/lenovoraw         flags=display="Lenovo Raw";backup=1;flashimg=1
/bootloader               emmc      /dev/block/by-name/lk                flags=display="LK (Bootloader)";backup=1;flashimg=1
/bootloader2              emmc      /dev/block/by-name/lk2               flags=display="LK2 (Bootloader Backup)";backup=1;flashimg=1
/misc                     emmc      /dev/block/by-name/misc              flags=display="Misc";backup=1;flashimg=1
/para                     emmc      /dev/block/by-name/para              flags=display="Para";backup=1;flashimg=1
/logo                     emmc      /dev/block/by-name/logo              flags=display="Logo";backup=1;flashimg=1
/expdb                    emmc      /dev/block/by-name/expdb             flags=display="ExpDB";backup=1;flashimg=1
/seccfg                   emmc      /dev/block/by-name/seccfg            flags=display="SecCfg";backup=1;flashimg=1
/tee1                     emmc      /dev/block/by-name/tee1              flags=display="TEE1";backup=1;flashimg=1
/tee2                     emmc      /dev/block/by-name/tee2              flags=display="TEE2";backup=1;flashimg=1
/tzar                     emmc      /dev/block/by-name/tzar              flags=display="TZAR";backup=1;flashimg=1
/scp1                     emmc      /dev/block/by-name/scp1              flags=display="SCP1";backup=1;flashimg=1
/scp2                     emmc      /dev/block/by-name/scp2              flags=display="SCP2";backup=1;flashimg=1
/sspm_1                   emmc      /dev/block/by-name/sspm_1            flags=display="SSPM 1";backup=1;flashimg=1
/sspm_2                   emmc      /dev/block/by-name/sspm_2            flags=display="SSPM 2";backup=1;flashimg=1
/md1img                   emmc      /dev/block/by-name/md1img            flags=display="Modem";backup=1;flashimg=1
/modem                    emmc      /dev/block/by-name/modem             flags=display="Modem DSP";backup=1;flashimg=1
/md1dsp                   emmc      /dev/block/by-name/md1dsp            flags=display="MD1 DSP";backup=1;flashimg=1
/gz1                      emmc      /dev/block/by-name/gz1               flags=display="GZ1";backup=1;flashimg=1
/gz2                      emmc      /dev/block/by-name/gz2               flags=display="GZ2";backup=1;flashimg=1
/uh                       emmc      /dev/block/by-name/uh                flags=display="UH";backup=1;flashimg=1
/spmfw                    emmc      /dev/block/by-name/spmfw             flags=display="SPMFW";backup=1;flashimg=1
/boot_para                emmc      /dev/block/by-name/boot_para         flags=display="Boot Para";backup=1;flashimg=1
/otp                      emmc      /dev/block/by-name/otp               flags=display="OTP";backup=1;flashimg=1

# External Storage & USB OTG (Support both /usb_otg and /usb-otg)
/external_sd              auto      /dev/block/mmcblk1p1    /dev/block/mmcblk1       flags=display="MicroSD Card";storage;wipeingui;removable;fsflags="utf8"
/usb_otg                  auto      /dev/block/sda1         /dev/block/sda           flags=display="USB OTG";storage;wipeingui;removable;fsflags="utf8"
/usb-otg                  auto      /dev/block/sda1         /dev/block/sda           flags=display="USB-OTG";storage;wipeingui;removable;fsflags="utf8"

# Dynamic Super Direct Mappings (for flashing raw partition images)
/system_image             emmc      /dev/block/mapper/system             flags=display="System Image";backup=0;flashimg=1
/system_ext_image         emmc      /dev/block/mapper/system_ext         flags=display="System_EXT Image";backup=0;flashimg=1
/vendor_image             emmc      /dev/block/mapper/vendor             flags=display="Vendor Image";backup=0;flashimg=1
/product_image            emmc      /dev/block/mapper/product            flags=display="Product Image";backup=0;flashimg=1
/vendor_dlkm_image        emmc      /dev/block/mapper/vendor_dlkm        flags=display="Vendor_DLKM Image";backup=0;flashimg=1
/odm_dlkm_image           emmc      /dev/block/mapper/odm_dlkm           flags=display="ODM_DLKM Image";backup=0;flashimg=1
/system_dlkm_image        emmc      /dev/block/mapper/system_dlkm        flags=display="System_DLKM Image";backup=0;flashimg=1
